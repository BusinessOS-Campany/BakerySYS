// Bakery ERP & POS — PostgreSQL schema
// Money and quantities: NUMERIC (never floating point).
// Business records are scoped by tenantId + (where relevant) branchId.
// Referential constraints are added in migration `add_integrity_constraints`
// so that every business table keeps an explicit, auditable foreign key.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────
enum StockDirection {
  IN
  OUT
}

enum SaleStatus {
  COMPLETED
  HELD
  CANCELLED
  REFUNDED
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COGS
  EXPENSE
}

// ─────────────────── Organization & access ───────────────────
model Tenant {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  nameAr                String
  nameEn                String
  currencyCode          String   @default("YER")
  decimalPlaces         Int      @default(2)
  locale                String   @default("ar")
  timezone              String   @default("Asia/Aden")
  taxEnabled            Boolean  @default(false)
  taxRate               Decimal  @default(0) @db.Decimal(9, 4)
  fiscalYearStartMonth  Int      @default(1)
  invoicePrefix         String   @default("INV")
  logoUrl               String?
  address               String?
  phone                 String?
  email                 String?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@map("tenants")
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  nameAr    String
  nameEn    String
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String?
  code      String
  nameAr    String
  nameEn    String
  kind      String   @default("BOTH") // RAW | FINISHED | BOTH
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, code])
  @@index([tenantId, branchId])
  @@map("warehouses")
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String    @unique
  phone        String?
  nameAr       String
  nameEn       String
  passwordHash String
  locale       String    @default("ar")
  avatarUrl    String?
  active       Boolean   @default(true)
  mustReset    Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  nameAr      String
  nameEn      String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([tenantId, code])
  @@map("roles")
}

model Permission {
  code        String   @id
  description String?
  module      String
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  tenantId     String
  roleId       String
  permission   String
  createdAt    DateTime @default(now())
  @@unique([roleId, permission])
  @@index([tenantId, roleId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  roleId    String
  branchId  String?
  createdAt DateTime @default(now())
  @@unique([userId, roleId, branchId])
  @@index([tenantId, userId])
  @@map("user_roles")
}

model UserBranchAccess {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  branchId  String
  createdAt DateTime @default(now())
  @@unique([userId, branchId])
  @@map("user_branch_access")
}

model Session {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId, userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([tenantId, userId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  requestId  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@map("audit_logs")
}

// ─────────────────── Products, units & ingredients ───────────────────
model UnitOfMeasure {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  nameAr    String
  nameEn    String
  precision Int      @default(3)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, code])
  @@map("units_of_measure")
}

model UnitConversion {
  id         String   @id @default(cuid())
  tenantId   String
  fromUnitId String
  toUnitId   String
  factor     Decimal  @db.Decimal(20, 8)
  createdAt  DateTime @default(now())
  @@unique([tenantId, fromUnitId, toUnitId])
  @@map("unit_conversions")
}

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  parentId  String?
  code      String
  nameAr    String
  nameEn    String
  kind      String   @default("PRODUCT") // PRODUCT | INGREDIENT | EXPENSE
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, code, kind])
  @@index([tenantId, kind])
  @@map("categories")
}

model Ingredient {
  id                 String   @id @default(cuid())
  tenantId           String
  categoryId         String?
  sku                String
  nameAr             String
  nameEn             String
  baseUnitId         String
  purchaseUnitId     String
  conversionFactor   Decimal  @default(1) @db.Decimal(20, 8)
  currentCost        Decimal  @default(0) @db.Decimal(18, 4)
  minStock           Decimal  @default(0) @db.Decimal(18, 4)
  maxStock           Decimal  @default(0) @db.Decimal(18, 4)
  storageRequirement String?
  trackExpiry        Boolean  @default(false)
  imageUrl           String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@unique([tenantId, sku])
  @@index([tenantId, categoryId])
  @@map("ingredients")
}

model PriceHistory {
  id           String   @id @default(cuid())
  tenantId     String
  ingredientId String
  supplierId   String?
  price        Decimal  @db.Decimal(18, 4)
  effectiveAt  DateTime @default(now())
  source       String?
  createdAt    DateTime @default(now())
  @@index([tenantId, ingredientId, effectiveAt])
  @@map("price_history")
}

model Product {
  id            String   @id @default(cuid())
  tenantId      String
  categoryId    String?
  recipeId      String?
  sku           String
  barcode       String?
  nameAr        String
  nameEn        String
  descriptionAr String?
  descriptionEn String?
  imageUrl      String?
  baseUnitId    String
  piecesPerUnit Decimal  @default(1) @db.Decimal(18, 4)
  sellingPrice  Decimal  @db.Decimal(18, 4)
  costPrice     Decimal  @default(0) @db.Decimal(18, 4)
  taxRate       Decimal  @default(0) @db.Decimal(9, 4)
  shelfLifeDays Int?
  minStock      Decimal  @default(0) @db.Decimal(18, 4)
  maxStock      Decimal  @default(0) @db.Decimal(18, 4)
  isWeighted    Boolean  @default(false)
  isCustomizable Boolean @default(false)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([tenantId, sku])
  @@index([tenantId, categoryId])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(cuid())
  tenantId       String
  productId      String
  nameAr         String
  nameEn         String
  sku            String
  barcode        String?
  priceAdjustment Decimal @default(0) @db.Decimal(18, 4)
  costAdjustment  Decimal @default(0) @db.Decimal(18, 4)
  attributes     Json?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([tenantId, sku])
  @@index([productId])
  @@map("product_variants")
}

model ProductPrice {
  id         String   @id @default(cuid())
  tenantId   String
  productId  String
  variantId  String?
  branchId   String?
  priceList  String   @default("DEFAULT")
  price      Decimal  @db.Decimal(18, 4)
  validFrom  DateTime @default(now())
  validTo    DateTime?
  createdAt  DateTime @default(now())
  @@index([tenantId, productId, branchId])
  @@map("product_prices")
}

model ProductBarcode {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  variantId String?
  barcode   String
  unitId    String?
  factor    Decimal  @default(1) @db.Decimal(20, 8)
  @@unique([tenantId, barcode])
  @@map("product_barcodes")
}

model ProductModifier {
  id        String   @id @default(cuid())
  tenantId  String
  nameAr    String
  nameEn    String
  price     Decimal  @default(0) @db.Decimal(18, 4)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  @@map("product_modifiers")
}

// ─────────────────── Inventory ───────────────────
model IngredientStock {
  id           String   @id @default(cuid())
  tenantId     String
  warehouseId  String
  ingredientId String
  quantity     Decimal  @default(0) @db.Decimal(18, 4)
  reserved     Decimal  @default(0) @db.Decimal(18, 4)
  version      Int      @default(0)
  updatedAt    DateTime @updatedAt
  @@unique([tenantId, warehouseId, ingredientId])
  @@index([tenantId, ingredientId])
  @@map("ingredient_stock")
}

model IngredientLot {
  id           String    @id @default(cuid())
  tenantId     String
  warehouseId  String
  ingredientId String
  supplierId   String?
  lotNumber    String
  quantity     Decimal   @db.Decimal(18, 4)
  initialQty   Decimal   @db.Decimal(18, 4)
  unitCost     Decimal   @db.Decimal(18, 4)
  itemState    String    @default("GRAINS") // GRAINS | GROUND
  cleaned      Boolean   @default(false)
  receivedAt   DateTime  @default(now())
  expiryDate   DateTime?
  createdAt    DateTime  @default(now())
  @@unique([tenantId, warehouseId, ingredientId, lotNumber])
  @@index([tenantId, ingredientId, expiryDate])
  @@map("ingredient_lots")
}

model IngredientMovement {
  id           String        @id @default(cuid())
  tenantId     String
  warehouseId  String
  ingredientId String
  lotId        String?
  direction    StockDirection
  quantity     Decimal       @db.Decimal(18, 4) // always positive; direction decides sign
  unitCost     Decimal       @default(0) @db.Decimal(18, 4)
  movementType String        // PURCHASE_RECEIPT, PRODUCTION_CONSUMPTION, ...
  referenceType String?
  referenceId  String?
  note         String?
  createdById  String?
  createdAt    DateTime      @default(now())
  @@index([tenantId, ingredientId, createdAt])
  @@index([tenantId, warehouseId, createdAt])
  @@index([tenantId, referenceType, referenceId])
  @@map("ingredient_movements")
}

model FinishedStock {
  id          String   @id @default(cuid())
  tenantId    String
  warehouseId String
  productId   String
  variantId   String?
  quantity    Decimal  @default(0) @db.Decimal(18, 4)
  reserved    Decimal  @default(0) @db.Decimal(18, 4)
  version     Int      @default(0)
  updatedAt   DateTime @updatedAt
  @@unique([tenantId, warehouseId, productId, variantId])
  @@index([tenantId, productId])
  @@map("finished_stock")
}

model FinishedLot {
  id              String    @id @default(cuid())
  tenantId        String
  warehouseId     String
  productId       String
  variantId       String?
  batchId         String?
  lotNumber       String
  quantity        Decimal   @db.Decimal(18, 4)
  initialQty      Decimal   @db.Decimal(18, 4)
  unitCost        Decimal   @db.Decimal(18, 4)
  producedAt      DateTime  @default(now())
  expiryDate      DateTime?
  qualityApproved Boolean   @default(false)
  createdAt       DateTime  @default(now())
  @@unique([tenantId, warehouseId, productId, lotNumber])
  @@index([tenantId, productId, expiryDate])
  @@map("finished_lots")
}

model FinishedMovement {
  id           String        @id @default(cuid())
  tenantId     String
  warehouseId  String
  productId    String
  variantId    String?
  lotId        String?
  direction    StockDirection
  quantity     Decimal       @db.Decimal(18, 4)
  unitCost     Decimal       @default(0) @db.Decimal(18, 4)
  movementType String
  referenceType String?
  referenceId  String?
  note         String?
  createdById  String?
  createdAt    DateTime      @default(now())
  @@index([tenantId, productId, createdAt])
  @@index([tenantId, referenceType, referenceId])
  @@map("finished_movements")
}

model StockAdjustment {
  id           String   @id @default(cuid())
  tenantId     String
  warehouseId  String
  itemType     String   // RAW | FINISHED
  itemId       String
  quantity     Decimal  @db.Decimal(18, 4) // signed difference
  reason       String
  approvedById String
  note         String?
  createdAt    DateTime @default(now())
  @@index([tenantId, createdAt])
  @@map("stock_adjustments")
}

model StockCount {
  id          String   @id @default(cuid())
  tenantId    String
  warehouseId String
  itemType    String
  countDate   DateTime @default(now())
  status      String   @default("DRAFT")
  createdById String
  notes       String?
  createdAt   DateTime @default(now())
  @@map("stock_counts")
}

model StockCountLine {
  id         String  @id @default(cuid())
  tenantId   String
  countId    String
  itemType   String
  itemId     String
  expected   Decimal @db.Decimal(18, 4)
  counted    Decimal @db.Decimal(18, 4)
  difference Decimal @db.Decimal(18, 4)
  @@index([countId])
  @@map("stock_count_lines")
}

model WarehouseTransfer {
  id            String   @id @default(cuid())
  tenantId      String
  fromWarehouse String
  toWarehouse   String
  itemType      String
  itemId        String
  quantity      Decimal  @db.Decimal(18, 4)
  status        String   @default("DRAFT")
  createdById   String
  transferredAt DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  @@index([tenantId, createdAt])
  @@map("warehouse_transfers")
}

// ─────────────────── Recipes ───────────────────
model Recipe {
  id              String   @id @default(cuid())
  tenantId        String
  productId       String
  nameAr          String
  nameEn          String
  description     String?
  prepMinutes     Int      @default(0)
  bakeTempC       Int?
  bakeMinutes     Int?
  restMinutes     Int      @default(0)
  yieldQuantity   Decimal  @default(1) @db.Decimal(18, 4)
  portions        Int      @default(1)
  laborCost       Decimal  @default(0) @db.Decimal(18, 4)
  packagingCost   Decimal  @default(0) @db.Decimal(18, 4)
  overheadCost    Decimal  @default(0) @db.Decimal(18, 4)
  instructions    String?
  imageUrl        String?
  active          Boolean  @default(true)
  currentVersion  Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([tenantId, productId])
  @@map("recipes")
}

model RecipeVersion {
  id           String   @id @default(cuid())
  tenantId     String
  recipeId     String
  version      Int
  effectiveFrom DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())
  @@unique([recipeId, version])
  @@map("recipe_versions")
}

model RecipeIngredient {
  id              String  @id @default(cuid())
  tenantId        String
  versionId       String
  ingredientId    String
  quantity        Decimal @db.Decimal(18, 4)
  unitId          String
  alternativeFor  String?
  isAlternative   Boolean @default(false)
  note            String?
  @@index([versionId])
  @@map("recipe_ingredients")
}

model RecipeInstruction {
  id        String @id @default(cuid())
  tenantId  String
  versionId String
  step      Int
  textAr    String?
  textEn    String?
  @@index([versionId])
  @@map("recipe_instructions")
}

model RecipeCostSnapshot {
  id            String   @id @default(cuid())
  tenantId      String
  recipeId      String
  versionId     String
  ingredientCost Decimal @db.Decimal(18, 4)
  laborCost     Decimal  @db.Decimal(18, 4)
  packagingCost Decimal  @db.Decimal(18, 4)
  overheadCost  Decimal  @db.Decimal(18, 4)
  totalCost     Decimal  @db.Decimal(18, 4)
  costPerUnit   Decimal  @db.Decimal(18, 4)
  sellingPrice  Decimal  @db.Decimal(18, 4)
  grossProfit   Decimal  @db.Decimal(18, 4)
  profitPercent Decimal  @db.Decimal(9, 4)
  lineItems     Json?
  calculatedAt  DateTime @default(now())
  @@index([tenantId, recipeId, calculatedAt])
  @@map("recipe_cost_snapshots")
}

// ─────────────────── Purchasing ───────────────────
model PurchaseRequest {
  id           String   @id @default(cuid())
  tenantId     String
  number       String
  branchId     String?
  warehouseId  String?
  status       String   @default("DRAFT")
  notes        String?
  requestedBy  String
  approvedBy   String?
  createdAt    DateTime @default(now())
  @@unique([tenantId, number])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id           String   @id @default(cuid())
  tenantId     String
  requestId    String
  ingredientId String
  quantity     Decimal  @db.Decimal(18, 4)
  unitId       String
  note         String?
  @@index([requestId])
  @@map("purchase_request_items")
}

model PurchaseOrder {
  id           String   @id @default(cuid())
  tenantId     String
  supplierId   String
  branchId     String?
  warehouseId  String
  number       String
  status       String   @default("DRAFT") // DRAFT, APPROVED, PARTIAL, RECEIVED, CANCELLED
  orderDate    DateTime @default(now())
  expectedDate DateTime?
  total        Decimal  @default(0) @db.Decimal(18, 4)
  notes        String?
  approvedById String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([tenantId, number])
  @@index([tenantId, supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id           String  @id @default(cuid())
  tenantId     String
  orderId      String
  ingredientId String
  quantity     Decimal @db.Decimal(18, 4)
  unitId       String
  unitPrice    Decimal @db.Decimal(18, 4)
  receivedQty  Decimal @default(0) @db.Decimal(18, 4)
  @@index([orderId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id             String   @id @default(cuid())
  tenantId       String
  orderId        String?
  supplierId     String
  warehouseId    String
  number         String
  receivedAt     DateTime @default(now())
  status         String   @default("PENDING") // PENDING, INSPECTED, REJECTED
  inspectionNote String?
  inspectedBy    String?
  total          Decimal  @default(0) @db.Decimal(18, 4)
  createdById    String
  createdAt      DateTime @default(now())
  @@unique([tenantId, number])
  @@index([tenantId, supplierId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id               String    @id @default(cuid())
  tenantId         String
  receiptId        String
  orderItemId      String?
  ingredientId     String
  quantity         Decimal   @db.Decimal(18, 4)
  acceptedQuantity Decimal   @db.Decimal(18, 4)
  rejectedQuantity Decimal   @default(0) @db.Decimal(18, 4)
  unitId           String
  unitCost         Decimal   @db.Decimal(18, 4)
  lotNumber        String?
  expiryDate       DateTime?
  @@index([receiptId])
  @@map("goods_receipt_items")
}

model SupplierInvoice {
  id           String   @id @default(cuid())
  tenantId     String
  supplierId   String
  receiptId    String?
  number       String
  invoiceDate  DateTime @default(now())
  dueDate      DateTime?
  amount       Decimal  @db.Decimal(18, 4)
  paidAmount   Decimal  @default(0) @db.Decimal(18, 4)
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())
  @@unique([tenantId, number])
  @@map("supplier_invoices")
}

model SupplierPayment {
  id           String   @id @default(cuid())
  tenantId     String
  supplierId   String
  invoiceId    String?
  amount       Decimal  @db.Decimal(18, 4)
  method       String   @default("CASH")
  reference    String?
  paidAt       DateTime @default(now())
  recordedBy   String
  createdAt    DateTime @default(now())
  @@index([tenantId, supplierId])
  @@map("supplier_payments")
}

model PurchaseReturn {
  id           String   @id @default(cuid())
  tenantId     String
  supplierId   String
  receiptId    String?
  number       String
  returnDate   DateTime @default(now())
  reason       String
  total        Decimal  @default(0) @db.Decimal(18, 4)
  createdBy    String
  createdAt    DateTime @default(now())
  @@unique([tenantId, number])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id           String  @id @default(cuid())
  tenantId     String
  returnId     String
  ingredientId String
  quantity     Decimal @db.Decimal(18, 4)
  unitCost     Decimal @db.Decimal(18, 4)
  @@index([returnId])
  @@map("purchase_return_items")
}

// ─────────────────── Customers & sales ───────────────────
model Customer {
  id            String   @id @default(cuid())
  tenantId      String
  code          String
  nameAr        String
  nameEn        String
  phone         String?
  email         String?
  balance       Decimal  @default(0) @db.Decimal(18, 4)
  creditLimit   Decimal  @default(0) @db.Decimal(18, 4)
  loyaltyPoints Int      @default(0)
  customerGroup String   @default("RETAIL")
  notes         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([tenantId, code])
  @@index([tenantId, phone])
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  label      String?
  address    String
  city       String?
  phone      String?
  isDefault  Boolean  @default(false)
  @@index([customerId])
  @@map("customer_addresses")
}

model Sale {
  id             String     @id @default(cuid())
  tenantId       String
  branchId       String
  warehouseId    String
  customerId     String?
  invoiceNumber  String
  status         SaleStatus @default(COMPLETED)
  invoiceDate    DateTime   @default(now())
  subtotal       Decimal    @db.Decimal(18, 4)
  discountAmount Decimal    @default(0) @db.Decimal(18, 4)
  taxAmount      Decimal    @default(0) @db.Decimal(18, 4)
  total          Decimal    @db.Decimal(18, 4)
  paidAmount     Decimal    @default(0) @db.Decimal(18, 4)
  isCredit       Boolean    @default(false)
  costAmount     Decimal    @default(0) @db.Decimal(18, 4)
  profit         Decimal    @default(0) @db.Decimal(18, 4)
  cashSessionId  String?
  cashierId      String
  idempotencyKey String?
  journalId      String?
  refundedAmount Decimal    @default(0) @db.Decimal(18, 4)
  notes          String?
